# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (required for bookings & admin dashboard)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-side Supabase service role key (DO NOT expose in frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Safaricom Daraja API credentials (server-only)
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_SHORTCODE="880100"
MPESA_ACCOUNT_REFERENCE="1006242177"
MPESA_PASSKEY="your-mpesa-passkey"
MPESA_CALLBACK_URL="https://your-app-url/api/callback/stk"
# Optional: use this when deploying production with Supabase Functions instead of hardcoding MPESA_CALLBACK_URL
SUPABASE_PROJECT_REF="your-supabase-project-ref"
MPESA_ENVIRONMENT="sandbox"

# Twilio / WhatsApp notifications (optional)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM="+1234567890"
WHATSAPP_FROM="whatsapp:+1234567890"

# SendGrid email notifications (optional)
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@yourdomain.com"

# Comma-separated emails allowed to sign in at /admin (must exist in Supabase Auth)
VITE_ADMIN_EMAILS="admin@example.com"
